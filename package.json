{
	"name": "retake",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.6.2",
	"engines": {
		"node": ">=22.18.0"
	},
	"prisma": {
		"schema": "prisma/schema"
	},
	"scripts": {
		"dev": "next dev",
		"build": "prisma generate && next build",
		"start": "next start",
		"lint": "eslint . --max-warnings=0",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "node --experimental-test-module-mocks --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --test \"scripts/*.test.mjs\" \"src/**/*.test.mts\"",
		"test:db": "node --experimental-test-module-mocks --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --test --test-concurrency=1 \"src/**/*.db-test.mts\"",
		"test:e2e": "playwright test",
		"shots": "playwright test -c playwright.shots.config.ts",
		"prisma:generate": "prisma generate",
		"prisma:migrate:generate:check": "node scripts/generate-migration.mjs --check",
		"db:run-once": "node scripts/run-once-sql.mjs",
		"check:env": "node scripts/check-env-vars.mjs",
		"check:secrets": "node scripts/check-secrets.mjs --all",
		"check:rls": "node scripts/check-rls.mjs",
		"contact:messages": "node --env-file-if-exists=.env.local scripts/contact-messages.mjs",
		"check:ai-models": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/check-ai-models.mjs",
		"prepare": "git config core.hooksPath .githooks",
		"postinstall": "prisma generate"
	},
	"dependencies": {
		"@google/genai": "^2.25.0",
		"@phosphor-icons/react": "^2.1.10",
		"@prisma/client": "^6.19.3",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-toast": "^1.2.23",
		"@sentry/nextjs": "^10.70.0",
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.112.3",
		"@tanstack/react-query": "^5.101.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"next": "^16.3.0",
		"next-intl": "^4.13.6",
		"pino": "^10.3.1",
		"posthog-js": "^1.415.4",
		"posthog-node": "^5.48.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-error-boundary": "^6.1.3",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^9",
		"eslint-config-next": "^16.3.0",
		"fake-indexeddb": "6.2.5",
		"prettier": "^3",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"prisma": "^6.19.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.8.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@prisma/client",
			"@prisma/engines",
			"@sentry/cli",
			"@swc/core",
			"prisma",
			"unrs-resolver"
		]
	}
}
