// DB-backed feature flags (docs/rules/feature-flags.md). FeatureFlag is the
// global on/off config, written only through the flags.manage-gated admin
// action (src/server/actions/feature-flags.ts) and read server-side via Prisma
// (src/lib/flags/server.ts). FeatureFlagOverride is a per-user pin.
//
// FeatureFlag is GLOBAL config, not user-scoped, so it gets NO RLS statement —
// it's gated by the flags.manage admin action, not a user-owned row.
model FeatureFlag {
	key            String   @id
	enabled        Boolean  @default(false)
	rolloutPercent Int?
	// Granular columns (all nullable — a boolean flag leaves them unset):
	//   variant        a forced global variant for a variant/experiment flag
	//   variantWeights a { "control": 50, "test": 50 } split for a
	//                  PostHog-independent A/B/n (used only when no forced variant)
	//   payload        the flag's JSON payload (validated against its schema on read)
	// See src/lib/flags/server.ts and docs/rules/feature-flags.md.
	variant        String?
	variantWeights Json?
	payload        Json?
	description    String?
	updatedAt      DateTime @updatedAt

	@@map("feature_flags")
}

// userId is a PLAIN @db.Uuid column with NO @relation and NO back-relation on
// User: a relation would force a back-relation field on User (owned by another
// schema file), coupling the two. Overrides target app users by id only —
// cohort/percentage targeting is PostHog's job.
//
// feature_flag_overrides IS user-scoped, so its create migration ENABLEs ROW
// LEVEL SECURITY (no policy, no FORCE) — see docs/rules/feature-flags.md.
model FeatureFlagOverride {
	id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	flagKey String
	userId  String  @db.Uuid
	enabled Boolean
	// A pin can force a specific variant or payload for this user, not just
	// on/off (both nullable). See src/lib/flags/server.ts.
	variant String?
	payload Json?

	@@unique([flagKey, userId])
	@@map("feature_flag_overrides")
}
