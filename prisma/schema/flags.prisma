// The template's database-backed feature flags. Retake has no feature flags,
// and no code reads or writes these tables: they're kept only because
// dropping them is a migration (with admin_members, in authz.prisma), left
// for its own change. FeatureFlag was global config; FeatureFlagOverride a
// per-user pin.
model FeatureFlag {
	key            String   @id
	enabled        Boolean  @default(false)
	rolloutPercent Int?
	// Granular columns (all nullable — a boolean flag leaves them unset):
	//   variant        a forced global variant for a variant/experiment flag
	//   variantWeights a { "control": 50, "test": 50 } split for a
	//                  PostHog-independent A/B/n (used only when no forced variant)
	//   payload        the flag's JSON payload
	variant        String?
	variantWeights Json?
	payload        Json?
	description    String?
	updatedAt      DateTime @updatedAt

	@@map("feature_flags")
}

// userId is a PLAIN @db.Uuid column with NO @relation and NO back-relation on
// User: a relation would force a back-relation field on User (owned by another
// schema file), coupling the two. Overrides target app users by id only —
// cohort/percentage targeting is PostHog's job.
//
// feature_flag_overrides IS user-scoped, so its create migration ENABLEs ROW
// LEVEL SECURITY (no policy, no FORCE) — see docs/rules/auth.md.
model FeatureFlagOverride {
	id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	flagKey String
	userId  String  @db.Uuid
	enabled Boolean
	// A pin could force a specific variant or payload for this user, not just
	// on/off (both nullable).
	variant String?
	payload Json?

	@@unique([flagKey, userId])
	@@map("feature_flag_overrides")
}
