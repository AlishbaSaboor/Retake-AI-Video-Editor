// Messages sent from the Contact us page while it existed (removed on
// 2026-10-13; nothing writes here now), kept in this project's own database:
// nothing was emailed or sent to an outside service. Read them with
// `pnpm contact:messages`. No user is attached: only a keyed hash of the
// sender's IP, from the per-sender limit the form had.
model ContactMessage {
	id        String   @id @default(cuid())
	/// Optional on the form; null when left empty.
	name      String?
	email     String
	message   String
	/// HMAC-SHA256 of the sender's IP with the form's key; never the IP
	/// itself. Null when the IP or the key wasn't known (a shared limit).
	ipHash    String?  @map("ip_hash")
	createdAt DateTime @default(now()) @db.Timestamptz(6)

	@@index([createdAt])
	@@index([ipHash, createdAt])
	@@map("contact_messages")
}
