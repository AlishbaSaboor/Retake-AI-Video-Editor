// The template's admin roles. Retake has no admin console, and no code reads
// or writes this table: it's kept only because dropping it is a migration
// (with feature_flags and feature_flag_overrides, in flags.prisma), left for
// its own change.
enum AdminRole {
	super_admin
	admin
	support
	read_only
}

// admin_members is user-scoped, so its create migration ENABLEs ROW LEVEL
// SECURITY (no policy, no FORCE) — see docs/rules/auth.md.
model AdminMember {
	userId           String    @id @db.Uuid
	role             AdminRole @default(read_only)
	permissionGrants String[]
	isActive         Boolean   @default(true)
	grantedById      String?   @db.Uuid
	createdAt        DateTime  @default(now()) @db.Timestamptz(6)
	updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
	user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@map("admin_members")
}
